#: includes/class-m4w-wco-rules.php:105
msgid "Choose at least one trigger product."
msgstr "Vyberte aspoň jeden spúšťací produkt."

#: includes/class-m4w-wco-rules.php:109
msgid "Choose an offer product."
msgstr "Vyberte ponúkaný produkt."

#: includes/class-m4w-wco-rules.php:113
msgid "The offer product cannot also be a trigger product for the same rule."
msgstr ""
"Ponúkaný produkt nemôže byť zároveň spúšťacím produktom pre toto isté "
"pravidlo."

#: includes/class-m4w-wco-rules.php:118
#, php-format
msgid "Trigger product #%d was not found."
msgstr "Spúšťací produkt #%d sa nenašiel."

#: includes/class-m4w-wco-rules.php:123
#, php-format
msgid "Offer product #%d was not found."
msgstr "Ponúkaný produkt #%d sa nenašiel."

#: includes/class-m4w-wco-rules.php:129
msgid "Discount value must be greater than 0 when discount is enabled."
msgstr "Hodnota zľavy musí byť väčšia ako 0, keď je zľava povolená."

#: includes/class-m4w-wco-rules.php:132
msgid "Percentage discount cannot exceed 100%."
msgstr "Percentuálna zľava nemôže presiahnuť 100 %."

